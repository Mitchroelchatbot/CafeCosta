---
import Base from '../layouts/Base.astro';
---

<Base
  title="Sollicitatie ontvangen | Café Costa Eindhoven"
  description="Je sollicitatie is binnen! Je hoort binnen 24 uur van ons."
>
  <section class="flex min-h-svh flex-col justify-center bg-magenta pt-16 text-white">
    <div class="wrap py-20">
      <p class="eyebrow">Werken bij Costa</p>
      <h1 class="display display-hero mt-4">Je sollicitatie is binnen!</h1>
      <p class="mt-8 max-w-xl text-lg text-white/90">
        Je hoort binnen 24 uur van ons — meestal veel sneller. Houd je telefoon en je mail (en spamfolder) in de gaten.
      </p>
      <a href="/" class="btn-primary mt-10 !bg-ink hover:!bg-ink-2">Terug naar home</a>
    </div>
  </section>
</Base>
