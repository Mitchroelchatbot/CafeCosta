---
import Base from '../layouts/Base.astro';
---

<Base
  title="Sollicitatie ontvangen | Café Costa Eindhoven"
  description="Je sollicitatie is binnen! Je hoort binnen 24 uur van ons."
>
  <section class="mx-auto flex min-h-svh max-w-3xl flex-col justify-center px-4 py-32 sm:px-6">
    <h1 class="display text-4xl text-white sm:text-6xl">Je sollicitatie is <span class="text-sun">binnen!</span></h1>
    <p class="mt-6 max-w-xl text-lg text-cream/85">
      Je hoort binnen 24 uur van ons — meestal veel sneller. Houd je telefoon en je mail (en spamfolder) in de gaten.
    </p>
    <a href="/" class="btn-primary mt-10 self-start">Terug naar home</a>
  </section>
</Base>
