---
import Base from '../layouts/Base.astro';
import tickets from '../data/tickets.json';
import { aankomendeSpecials, datumFormat, eventSchema as maakEventSchema, isExtern } from '../data/specials';

// Alleen events met kaartverkoop horen op de ticketpagina
const events = aankomendeSpecials.filter((s) => s.ticketUrl);
const eventSchema = maakEventSchema(events);

const shopEmbed = (tickets.shopEmbed as string | null)?.trim() || null;
const shopUrl = (tickets.shopUrl as string | null)?.trim() || null;
const shopGekoppeld = Boolean(shopEmbed || shopUrl);
---

<Base
  title="Tickets | Café Costa Eindhoven — oud & nieuw en specials op het Stratumseind"
  description="Bestel je tickets voor de specials van Café Costa op het Stratumseind, zoals New Years Eve 2026-2027 met gratis entree en all you can drink voor € 35."
  ogImage={events[0]?.poster ?? undefined}
>
  {eventSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}

  {/* PAGINAKOP */}
  <section class="bg-ink pt-16">
    <div class="wrap pb-6 pt-14 sm:pt-20">
      <p class="eyebrow text-paper/70"><span class="text-magenta-hot">Tickets</span> — Specials &amp; events</p>
      <h1 class="display mt-2 text-[clamp(5rem,24vw,22rem)] leading-[0.82] text-paper">Tickets</h1>
    </div>
  </section>

  {/* EVENTS MET KAARTVERKOOP (bron: src/data/specials.json) */}
  {
    events.map((s, i) => (
      <section class:list={[i % 2 === 0 ? 'bg-ink' : 'bg-paper text-ink']}>
        <div class:list={['wrap pb-20 pt-10 sm:pb-28', i === 0 && 'border-t border-white/20']}>
          <p class="eyebrow">
            <span class="text-magenta-hot">{datumFormat.format(new Date(`${s.datum}T12:00:00`))}</span>
            {s.tijd && <> — vanaf {s.tijd} uur</>}
          </p>
          <h2 class="display display-xl mt-5 max-w-[16ch]">{s.titel}</h2>

          <div class="mt-10 grid gap-10 lg:grid-cols-12">
            {s.poster && (
              <img
                src={s.poster}
                alt={s.posterAlt ?? `Poster: ${s.titel}`}
                width="1600"
                height="900"
                class="w-full lg:col-span-7"
              />
            )}
            <div class:list={[s.poster ? 'lg:col-span-5' : 'lg:col-span-8']}>
              <p class="text-lg opacity-80">{s.tekst}</p>

              {s.lineup?.length && (
                <div class="mt-8">
                  <h3 class="eyebrow opacity-60">Line-up</h3>
                  <ul class="mt-2">
                    {s.lineup.map((naam) => (
                      <li class="display display-md border-b border-current/20 py-2">{naam}</li>
                    ))}
                  </ul>
                </div>
              )}

              {s.details?.length && (
                <ul class="mt-8">
                  {s.details.map((d) => (
                    <li class="flex gap-4 border-b border-current/15 py-3">
                      <span class="text-magenta-hot" aria-hidden="true">—</span>
                      {d}
                    </li>
                  ))}
                </ul>
              )}

              {/* Interne ticketlink (/tickets) wijst naar de shop op deze pagina; externe links openen de shop van de provider */}
              {s.ticketUrl && isExtern(s.ticketUrl) ? (
                <a href={s.ticketUrl} target="_blank" rel="noopener" class="btn-primary mt-8">Bestel je ticket</a>
              ) : (
                <a href="#shop" class="btn-primary mt-8">Bestel je ticket</a>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  {/* TICKETSHOP (bron: src/data/tickets.json) */}
  <section id="shop" class="scroll-mt-16 bg-magenta text-white">
    <div class="wrap py-20 sm:py-28">
      <p class="eyebrow">Ticketshop</p>
      <h2 class="display display-xl mt-5">Bestel je tickets</h2>

      {/* Alleen een shoplink: grote knop. Embed + shoplink: de shop staat hier, de link is de reserve als het script niet laadt. */}
      {shopUrl && !shopEmbed && (
        <a href={shopUrl} target="_blank" rel="noopener" class="btn-primary mt-8 !bg-ink hover:!bg-ink-2">
          Naar de ticketshop
        </a>
      )}

      {shopEmbed && <div class="mt-10 bg-paper p-4 text-ink sm:p-8" set:html={shopEmbed} />}

      {shopEmbed && shopUrl && (
        <p class="mt-4 text-sm text-white/85">
          Zie je de shop niet?
          <a href={shopUrl} target="_blank" rel="noopener" class="font-semibold underline underline-offset-4">Open de ticketshop in een nieuw venster</a>.
        </p>
      )}

      {
        !shopGekoppeld && (
          /* TODO: ticketshop koppelen — embedcode of shoplink van de ticketprovider in src/data/tickets.json zetten. Niet live zetten zonder. */
          <div class="mt-10 border border-dashed border-white/60 p-8">
            <p class="eyebrow">Ticketshop wordt gekoppeld</p>
            <p class="mt-3 max-w-xl text-white/90">
              Hier komt de ticketshop van Café Costa. Tot die gekoppeld is, kun je hier nog niet bestellen.
            </p>
          </div>
        )
      }

      <p class="mt-10 max-w-xl text-sm text-white/80">
        Vragen over je ticket of een groepsboeking? Bekijk de <a href="/groepen" class="underline underline-offset-4">mogelijkheden voor groepen</a>.
      </p>
    </div>
  </section>
</Base>
