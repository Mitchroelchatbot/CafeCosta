---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import bladTeal from '../assets/decor/blad-teal-rechtsboven.webp';

import heroRuimte from '../assets/ruimte/ruimte-hero-overzicht.jpg';
import ruimteLichtshow from '../assets/ruimte/ruimte-overzicht-lichtshow.jpg';
import ruimteTafels from '../assets/ruimte/ruimte-tafels-en-bar.jpg';
import ruimteEigenBar from '../assets/ruimte/ruimte-eigen-bar.jpg';
import ruimteBarDetail from '../assets/ruimte/ruimte-bar-detail.jpg';
import ruimteDjBooth from '../assets/ruimte/ruimte-dj-booth.jpg';

// Foto's van de besloten ruimte — dezelfde volgorde als de fotostrip op de pagina.
// Voor de lightbox genereren we grote WebP-versies om doorheen te bladeren.
const ruimteFotos = [
  { img: heroRuimte, alt: 'Overzicht van de besloten ruimte van Café Costa op de eerste etage' },
  { img: ruimteLichtshow, alt: 'De besloten ruimte van Café Costa met sfeerverlichting en lichtshow' },
  { img: ruimteTafels, alt: 'Statafels en zitplekken in de besloten ruimte van Café Costa' },
  { img: ruimteEigenBar, alt: 'De eigen bar van de besloten ruimte van Café Costa' },
  { img: ruimteBarDetail, alt: 'Detail van de bar in de besloten ruimte van Café Costa' },
  { img: ruimteDjBooth, alt: 'De DJ-booth met lichtshow in de besloten ruimte van Café Costa' },
];
const ruimteFotosGroot = await Promise.all(
  ruimteFotos.map((f) => getImage({ src: f.img, width: 1600, format: 'webp' }))
);
const gallerySrcs = ruimteFotosGroot.map((f, i) => ({ src: f.src, alt: ruimteFotos[i].alt }));

const faq = [
  {
    q: 'Kan de besloten ruimte ook doordeweeks?',
    a: 'Altijd bespreekbaar. Zet je gewenste datum in de aanvraag en we kijken wat er kan.',
  },
  {
    q: 'Mogen we eigen muziek draaien?',
    a: 'Ja — er staat een DJ-booth klaar. Neem je eigen DJ mee of sluit je eigen playlist aan.',
  },
  {
    q: 'Tot hoe laat kan het feest doorgaan?',
    a: 'Op vrijdag en zaterdag tot 04:00, op overige dagen tot 02:00.',
  },
  {
    q: 'Wat als we met minder dan 20 of meer dan 60 zijn?',
    a: 'Kleiner gezelschap? Boek een VIP-tafel. Groter feest? Dan huur je heel Costa af — plan een gesprek.',
  },
  {
    q: 'Kunnen we ook gewoon met onze vrijgezellengroep binnenlopen zonder te boeken?',
    a: 'Altijd welkom — de deur staat open. Maar de Costa-behandeling voor de vrijgezel en de gegarandeerde tafel zijn er alleen voor geboekte groepen. Op een drukke zaterdag is dat het verschil tussen een thuisbasis en een uur zoeken naar een plek.',
  },
  {
    q: 'Hoe zit het met betalen?',
    a: 'Voor de VIP-tafel betaal je het tegoed van € 150 vooraf via een betaalverzoek — daarmee staat je tafel definitief vast. Voor de besloten ruimte geldt geen zaalhuur, alleen de minimale barbesteding van € 600 op de avond zelf.',
  },
  // TODO: FAQ-item "Kunnen we ook eten regelen?" toevoegen zodra de eigenaar de hapjes/platters-vraag beantwoordt (contentdoc "NOG AANLEVEREN" punt 2)
];
---

<Base
  title="Vrijgezellenfeest, bedrijfsfeest of VIP-tafel | Groepen & Verhuur — Café Costa Eindhoven"
  description="Vier je vrijgezellenfeest, bedrijfsfeest of verjaardag bij Café Costa op het Stratumseind. Huur de verborgen parel (20–60 pers., geen zaalhuur) of boek een VIP-tafel met € 150 tegoed."
  ogImage="/img/og-groepen.jpg"
>
  {/* HERO — beeld eerst, tekst minimaal: kop + feitenstrip + één knop, above the fold op 380px.
      TODO: foto vervangen door een vol-bedrijf-foto zodra die er is. */}
  <section id="groepen-hero" class="relative overflow-hidden">
    <Image
      src={heroRuimte}
      alt=""
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-night/70" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-night to-transparent" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 pb-10 pt-24 sm:px-6 sm:pb-16 sm:pt-40">
      <h1 class="display max-w-3xl text-3xl text-white sm:text-6xl">
        De verborgen parel <span class="text-sun">van het Stratumseind</span>
      </h1>
      <p class="mt-3 max-w-2xl text-base text-cream/90 sm:mt-5 sm:text-xl">
        Jouw privéfeest, één trap boven de drukste stapstraat van de Benelux.
      </p>

      {/* Feitenstrip — de pitch in één oogopslag; 2×2 op mobiel, 4 naast elkaar op desktop */}
      <ul class="mt-4 grid max-w-3xl grid-cols-2 gap-2 sm:mt-7 sm:gap-3 lg:grid-cols-4">
        <li class="flex items-center gap-2.5 rounded-xl border border-white/15 bg-night/70 px-3 py-2.5 backdrop-blur-sm">
          <svg class="h-5 w-5 shrink-0 text-magenta-hot" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10z"></path><circle cx="12" cy="11" r="2.5"></circle></svg>
          <span class="text-xs font-bold text-cream sm:text-sm">1e etage, midden op het Stratumseind</span>
        </li>
        <li class="flex items-center gap-2.5 rounded-xl border border-white/15 bg-night/70 px-3 py-2.5 backdrop-blur-sm">
          <svg class="h-5 w-5 shrink-0 text-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><path d="M4 19c0-2.8 2.2-5 5-5s5 2.2 5 5"></path><circle cx="16.5" cy="9" r="2.5"></circle><path d="M15 14.4c2.6.2 4.5 2.1 4.5 4.6"></path></svg>
          <span class="text-xs font-bold text-cream sm:text-sm">20 tot 60 personen</span>
        </li>
        <li class="flex items-center gap-2.5 rounded-xl border border-white/15 bg-night/70 px-3 py-2.5 backdrop-blur-sm">
          <svg class="h-5 w-5 shrink-0 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5h14l-7 8v5"></path><path d="M9 21h6"></path><path d="M8 9h8"></path></svg>
          <span class="text-xs font-bold text-cream sm:text-sm">Eigen bar, DJ-booth &amp; lichtshow</span>
        </li>
        <li class="flex items-center gap-2.5 rounded-xl border border-white/15 bg-night/70 px-3 py-2.5 backdrop-blur-sm">
          <svg class="h-5 w-5 shrink-0 text-magenta-hot" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 6.5a6.5 6.5 0 1 0 0 11"></path><path d="M5 10.5h8"></path><path d="M5 13.5h7"></path></svg>
          <span class="text-xs font-bold text-cream sm:text-sm">Geen zaalhuur — min. besteding € 600</span>
        </li>
      </ul>

      <div class="mt-5 sm:mt-8">
        <a href="#aanvragen" class="btn-primary" data-boek="Besloten ruimte">Vraag je datum aan</a>
      </div>
      <a href="#vip-tafel" class="mt-4 inline-block text-sm font-bold text-cream/75 underline-offset-4 hover:text-cream hover:underline">
        Liever een VIP-tafel in het café? ↓
      </a>
    </div>
  </section>

  {/* PRODUCT 1 — DE BESLOTEN RUIMTE / "de verborgen parel" (hoofdproduct) */}
  <section id="besloten-ruimte" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6">
    <p class="display text-sm text-teal">Het hoofdproduct</p>
    <h2 class="display mt-3 max-w-3xl text-3xl text-white sm:text-4xl">De verborgen parel van het Stratumseind</h2>
    <p class="mt-4 text-xl font-extrabold text-cream/90">Je eigen feest. Onze zaak.</p>

    <div class="mt-8 max-w-3xl">
      <p class="text-lg text-cream/85">
        Vijftig kroegen telt de langste stapstraat van de Benelux — en al sinds 2002 feest Costa er middenin. Maar wat
        de meeste stappers nooit te zien krijgen: één trap hoger, op de eerste etage, ligt een verborgen parel. Een
        eigen besloten ruimte voor 20 tot 60 personen, met de drukste straat van de Benelux onder je voeten. Intiem en
        gezellig als je dat wilt — en binnen een uur een knalfeest als het moet. Verjaardag, vrijgezellenfeest,
        bedrijfsborrel of gewoon omdat het vrijdag is.
      </p>
      <p class="mt-4 text-lg text-cream/85">
        En ja: officieel mogen er 90 mensen in. Wij houden het bewust op 60 — omdat een goed feest ademruimte nodig
        heeft.
      </p>
    </div>

    {/* Fotostrip — beeld verkoopt deze etage; klikbaar via de galerij-lightbox.
        TODO: dit zijn sfeerfoto's van de lege, aangeklede ruimte — maximaal twee vervangen door vol-bedrijf-foto's zodra die er zijn. */}
    <div class="mt-8 grid grid-cols-3 gap-2 sm:gap-3 lg:grid-cols-6">
      {
        ruimteFotos.map((f, i) => (
          <button
            type="button"
            data-gallery-index={i}
            class="ruimte-foto group relative block cursor-zoom-in overflow-hidden rounded-lg"
            aria-label={`Vergroot foto: ${f.alt}`}
          >
            <Image
              src={f.img}
              alt={f.alt}
              widths={[240, 480, 768]}
              sizes="(min-width: 1024px) 16vw, 30vw"
              loading="lazy"
              class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </button>
        ))
      }
    </div>

    <div class="mt-10">
      <h3 class="display text-sm text-cream/70">Wat krijg je</h3>
      <ul class="mt-4 grid gap-3 text-cream/85 sm:grid-cols-2">
        <li class="flex gap-3"><span class="text-teal" aria-hidden="true">★</span>Besloten ruimte voor 20 tot 60 personen</li>
        <li class="flex gap-3"><span class="text-teal" aria-hidden="true">★</span>Eigen bar met eigen barman of barvrouw</li>
        <li class="flex gap-3"><span class="text-teal" aria-hidden="true">★</span>DJ-booth, lichtshow en beamer — neem je eigen DJ mee of draai je eigen playlist</li>
        <li class="flex gap-3"><span class="text-teal" aria-hidden="true">★</span>Gratis toiletgebruik voor al je gasten, de hele avond</li>
      </ul>
      <p class="mt-8 max-w-3xl text-2xl font-extrabold text-sun">
        De deal: géén zaalhuur. Je betaalt alleen wat jullie drinken, met een minimale barbesteding van € 600.
      </p>
    </div>

    <div class="mt-10">
      <a href="#aanvragen" class="btn-primary" data-boek="Besloten ruimte">Vraag je datum aan</a>
      <p class="mt-4 text-sm text-cream/60">Je hoort binnen 24 uur van ons — meestal veel sneller.</p>
    </div>
  </section>

  {/* PRODUCT 2 — VIP-TAFEL */}
  <section id="vip-tafel" class="border-y border-night-line bg-night-soft">
    <div class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6">
      <p class="display text-sm text-magenta-hot">VIP-tafel</p>
      <h2 class="display mt-3 max-w-3xl text-3xl text-white sm:text-4xl">Jouw eigen tafel. Midden in het feest.</h2>
      <div class="mt-8 grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-lg text-cream/85">
            Zaterdagavond, Stratumseind, en jij hoeft nergens voor te vechten. Geen rij, geen zoeken, geen statafel
            delen met vreemden. Jullie tafel staat klaar, op naam — en de avond is al geregeld voordat je binnenstapt.
          </p>
          <p class="mt-6 text-2xl font-extrabold text-sun">€ 150 per tafel, volledig te besteden aan de bar</p>
        </div>
        <div>
          <h3 class="display text-sm text-cream/70">Wat krijg je</h3>
          <ul class="mt-4 space-y-3 text-cream/85">
            <li class="flex gap-3"><span class="text-magenta-hot" aria-hidden="true">★</span>Gereserveerde VIP-tafel voor 6 tot 12 personen, de hele avond van jullie</li>
            <li class="flex gap-3"><span class="text-magenta-hot" aria-hidden="true">★</span>€ 150 drankentegoed, vooraf betaald — makkelijk vooraf te splitten met je vrienden</li>
            <li class="flex gap-3"><span class="text-magenta-hot" aria-hidden="true">★</span>Welkomstshotje voor de hele groep bij binnenkomst</li>
            <li class="flex gap-3"><span class="text-magenta-hot" aria-hidden="true">★</span>Alles geregeld, tot aan gratis toiletgebruik voor de hele groep — portemonnee kan de hele avond in je zak</li>
          </ul>
        </div>
      </div>
      <div class="mt-10">
        <a href="#aanvragen" class="btn-primary" data-boek="VIP-tafel">Vraag je tafel aan</a>
        <p class="mt-4 max-w-2xl text-sm text-cream/60">
          Maximaal 3 VIP-tafels per avond — vol is vol. Na je aanvraag ontvang je binnen 24 uur een bevestiging met
          betaalverzoek; je tafel staat definitief vast zodra het tegoed is voldaan. Tegoed is niet restitueerbaar, maar
          tot 7 dagen vooraf kun je eenmalig kosteloos een nieuwe datum kiezen. Vanaf 18 jaar.
        </p>
      </div>

      {/* DE VRIJGEZELLEN-EDITIE — variant van de VIP-tafel, zelfde prijs, zelfde boeking.
          Geen apart product: het formulierveld "gelegenheid: vrijgezellenfeest" is het signaal voor het ritueel. */}
      <div class="mt-12 rounded-2xl border border-magenta/40 bg-night p-8 sm:p-10">
        <p class="display text-sm text-magenta-hot">De vrijgezellen-editie</p>
        <h3 class="display mt-3 max-w-3xl text-2xl text-white sm:text-3xl">
          Vrijgezellenfeest? Dit is jullie thuisbasis.
        </h3>
        <p class="mt-5 max-w-3xl text-lg text-cream/85">
          Vijftig kroegen en één missie — dan wil je geen startpunt, maar een thuisbasis. Boek de VIP-tafel als vaste
          stek van je vrijgezellenfeest: begin bij ons, verover de straat, en kom terug wanneer je wilt. Jullie tafel
          blijft de hele avond staan, jullie tegoed staat op de bar te wachten.
        </p>
        <p class="mt-5 font-bold text-cream">En de vrijgezel? Die krijgt de Costa-behandeling:</p>
        <ul class="mt-4 max-w-3xl space-y-3 text-cream/85">
          <li class="flex gap-3"><span class="text-magenta-hot" aria-hidden="true">★</span>Een persoonlijke shout-out van de DJ, mét confettimoment — dit gebeurt áltijd, bij elke geboekte vrijgezellentafel</li>
          <li class="flex gap-3"><span class="text-magenta-hot" aria-hidden="true">★</span>Welkomstshotje voor de hele groep — en eentje extra voor de vrijgezel</li>
          <li class="flex gap-3"><span class="text-magenta-hot" aria-hidden="true">★</span>De vrijgezel tapt zijn of haar eerste biertje zélf, achter onze bar — camera's klaar</li>
        </ul>
        <a href="#aanvragen" class="btn-primary mt-8" data-boek="VIP-tafel" data-gelegenheid="Vrijgezellenfeest">Boek jullie thuisbasis</a>
      </div>
    </div>
  </section>

  {/* PRODUCT 3 — HELE ZAAK AFHUREN */}
  <section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-20 sm:px-6">
    {/* Bladeren-crop uit de banners (ronde 3-stijl), uitgefade naar de achtergrond */}
    <Image
      src={bladTeal}
      alt=""
      widths={[300, 550]}
      sizes="300px"
      loading="lazy"
      class="leaf-fade-tr pointer-events-none absolute -top-4 right-0 w-48 select-none opacity-60 sm:w-72"
      aria-hidden="true"
    />
    <p class="display text-sm text-sun">Heel Costa afhuren</p>
    <h2 class="display mt-3 max-w-3xl text-3xl text-white sm:text-4xl">Heel Costa. Alleen voor jullie.</h2>
    <p class="mt-6 max-w-3xl text-lg text-cream/85">
      Bedrijfsfeest, jubileum of een feest dat te groot is voor een zaaltje? Huur heel Café Costa af: de beste
      feest-DJ's van het land, confettikanonnen en een team van 50 man dat één opdracht heeft — jullie avond
      onvergetelijk maken. Capaciteit, invulling en prijs? Dat is maatwerk, en maatwerk begint met een gesprek.
    </p>
    <a href="#aanvragen" class="btn-primary mt-8" data-boek="Heel Costa">Plan een gesprek</a>
  </section>

  {/* AANVRAAGFORMULIER — één formulier voor alle drie de producten (Netlify Forms) */}
  <section id="aanvragen" class="border-y border-night-line bg-night-soft">
    <div class="mx-auto max-w-4xl scroll-mt-24 px-4 pt-16 sm:px-6 sm:pt-20">
      {/* Zo werkt het — drie stappen, vlak boven het formulier */}
      <h2 class="display text-2xl text-white sm:text-3xl">Zo werkt het</h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-3 sm:gap-6">
        <li class="flex items-start gap-4 rounded-xl border border-night-line bg-night p-5">
          <span class="display text-3xl text-magenta-hot" aria-hidden="true">1</span>
          <span class="pt-1 text-cream/85">Vraag je datum aan via het formulier</span>
        </li>
        <li class="flex items-start gap-4 rounded-xl border border-night-line bg-night p-5">
          <span class="display text-3xl text-sun" aria-hidden="true">2</span>
          <span class="pt-1 text-cream/85">Binnen 24 uur persoonlijke bevestiging</span>
        </li>
        <li class="flex items-start gap-4 rounded-xl border border-night-line bg-night p-5">
          <span class="display text-3xl text-teal" aria-hidden="true">3</span>
          <span class="pt-1 text-cream/85">Feesten — de rest regelen wij</span>
        </li>
      </ol>
    </div>

    <div class="mx-auto max-w-2xl px-4 py-14 sm:px-6 sm:py-16">
      <h2 class="display text-3xl text-white sm:text-4xl">Zet je avond vast</h2>
      <p class="mt-4 text-cream/80">Je hoort binnen 24 uur van ons — meestal veel sneller.</p>

      <form
        name="boekingsaanvraag"
        method="POST"
        action="/bedankt"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-10 space-y-6"
      >
        <input type="hidden" name="form-name" value="boekingsaanvraag" />
        <p class="hidden" aria-hidden="true">
          <label>Niet invullen als je een mens bent: <input name="bot-field" /></label>
        </p>

        <div>
          <label for="wat" class="label">Wat wil je boeken?</label>
          <select id="wat" name="wat-wil-je-boeken" required class="input">
            <option value="Besloten ruimte">Besloten ruimte</option>
            <option value="VIP-tafel">VIP-tafel</option>
            <option value="Heel Costa">Heel Costa</option>
          </select>
        </div>

        <div>
          <label for="naam" class="label">Naam</label>
          <input id="naam" name="naam" type="text" required autocomplete="name" class="input" />
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="email" class="label">E-mailadres</label>
            <input id="email" name="email" type="email" required autocomplete="email" class="input" />
          </div>
          <div>
            <label for="telefoon" class="label">Telefoonnummer</label>
            <input id="telefoon" name="telefoon" type="tel" required autocomplete="tel" class="input" />
            <p class="mt-1.5 text-xs text-cream/50">Zodat we kunnen bellen als dat sneller is.</p>
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="datum" class="label">Gewenste datum</label>
            <input id="datum" name="gewenste-datum" type="date" required class="input" />
          </div>
          <div>
            <label for="reservedatum" class="label">Reservedatum <span class="font-normal normal-case text-cream/50">(optioneel)</span></label>
            <input id="reservedatum" name="reservedatum" type="date" class="input" />
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="personen" class="label">Aantal personen</label>
            <input id="personen" name="aantal-personen" type="number" min="1" required class="input" />
          </div>
          <div>
            <label for="gelegenheid" class="label">Gelegenheid</label>
            <select id="gelegenheid" name="gelegenheid" required class="input">
              <option value="Verjaardag">Verjaardag</option>
              <option value="Vrijgezellenfeest">Vrijgezellenfeest</option>
              <option value="Bedrijfsfeest">Bedrijfsfeest</option>
              <option value="Anders">Anders</option>
            </select>
          </div>
        </div>

        <div>
          <label for="opmerkingen" class="label">Opmerkingen <span class="font-normal normal-case text-cream/50">(optioneel)</span></label>
          <textarea id="opmerkingen" name="opmerkingen" rows="4" class="input"></textarea>
        </div>

        <button type="submit" class="btn-primary w-full">Verstuur je aanvraag</button>
      </form>
    </div>
  </section>

  {/* VEELGESTELDE VRAGEN */}
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <h2 class="display text-3xl text-white sm:text-4xl">Veelgestelde vragen</h2>
    <div class="mt-8 divide-y divide-night-line">
      {
        faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold text-cream [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="text-magenta-hot transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-cream/80">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  {/* Sticky CTA op mobiel — verschijnt zodra de bezoeker voorbij de hero scrolt,
      verdwijnt zodra het formulier in beeld is (anders bedekt hij de verstuurknop) */}
  <div
    id="sticky-cta"
    class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-white/10 bg-night/90 p-3 backdrop-blur-md sm:!hidden"
  >
    <a href="#aanvragen" class="btn-primary w-full !py-3.5" data-boek="Besloten ruimte">Vraag je datum aan</a>
  </div>

  {/* Foto-lightbox met doorbladeren — vergroot op de site, weg te klikken */}
  <div
    id="foto-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-night/90 p-4 backdrop-blur-sm sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Foto's van de besloten ruimte"
  >
    <button
      type="button"
      data-gallery-close
      class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-night-soft text-cream transition-colors hover:bg-magenta focus-visible:outline-4 focus-visible:outline-sun sm:right-6 sm:top-6"
      aria-label="Sluiten"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>

    <button
      type="button"
      data-gallery-prev
      class="absolute left-2 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-night-soft/80 text-cream transition-colors hover:bg-magenta focus-visible:outline-4 focus-visible:outline-sun sm:left-6"
      aria-label="Vorige foto"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>

    <figure class="flex max-h-full max-w-5xl flex-col items-center gap-3">
      <img id="gallery-image" src="" alt="" class="max-h-[80vh] w-auto max-w-full rounded-xl shadow-2xl" />
      <figcaption id="gallery-counter" class="text-sm font-bold uppercase tracking-wide text-cream/70"></figcaption>
    </figure>

    <button
      type="button"
      data-gallery-next
      class="absolute right-2 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-night-soft/80 text-cream transition-colors hover:bg-magenta focus-visible:outline-4 focus-visible:outline-sun sm:right-6"
      aria-label="Volgende foto"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>

  <script type="application/json" id="gallery-data" is:inline set:html={JSON.stringify(gallerySrcs)} />
</Base>

<script>
  // Boek-knoppen vullen alvast de juiste keuze(s) in het formulier in
  const select = document.getElementById('wat') as HTMLSelectElement | null;
  const gelegenheid = document.getElementById('gelegenheid') as HTMLSelectElement | null;
  document.querySelectorAll<HTMLAnchorElement>('a[data-boek]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (select && btn.dataset.boek) select.value = btn.dataset.boek;
      if (gelegenheid && btn.dataset.gelegenheid) gelegenheid.value = btn.dataset.gelegenheid;
    });
  });

  // Sticky CTA op mobiel: tonen voorbij de hero, verbergen zodra het formulier in beeld is
  const stickyCta = document.getElementById('sticky-cta');
  const hero = document.getElementById('groepen-hero');
  const formSection = document.getElementById('aanvragen');
  if (stickyCta && hero && formSection) {
    let pastHero = false;
    let formInView = false;
    const update = () => stickyCta.classList.toggle('hidden', !pastHero || formInView);
    new IntersectionObserver(
      ([e]) => {
        pastHero = !e.isIntersecting;
        update();
      },
      { threshold: 0 }
    ).observe(hero);
    new IntersectionObserver(
      ([e]) => {
        formInView = e.isIntersecting;
        update();
      },
      { threshold: 0.1 }
    ).observe(formSection);
  }

  // Foto-lightbox met doorbladeren
  type Foto = { src: string; alt: string };
  const box = document.getElementById('foto-lightbox');
  const dataEl = document.getElementById('gallery-data');
  const imgEl = document.getElementById('gallery-image') as HTMLImageElement | null;
  const counterEl = document.getElementById('gallery-counter');

  if (box && dataEl && imgEl) {
    const fotos: Foto[] = JSON.parse(dataEl.textContent || '[]');
    const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-gallery-index]');
    let current = 0;
    let lastFocused: HTMLElement | null = null;

    const render = () => {
      const f = fotos[current];
      if (!f) return;
      imgEl.src = f.src;
      imgEl.alt = f.alt;
      if (counterEl) counterEl.textContent = `${current + 1} / ${fotos.length}`;
    };
    const open = (index: number) => {
      current = index;
      render();
      lastFocused = document.activeElement as HTMLElement;
      box.classList.remove('hidden');
      box.classList.add('flex');
      document.body.style.overflow = 'hidden';
      (box.querySelector('[data-gallery-close]') as HTMLElement | null)?.focus();
    };
    const close = () => {
      box.classList.add('hidden');
      box.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };
    const step = (delta: number) => {
      current = (current + delta + fotos.length) % fotos.length;
      render();
    };

    thumbs.forEach((btn) =>
      btn.addEventListener('click', () => open(Number(btn.dataset.galleryIndex)))
    );
    box.querySelector('[data-gallery-close]')?.addEventListener('click', close);
    box.querySelector('[data-gallery-prev]')?.addEventListener('click', () => step(-1));
    box.querySelector('[data-gallery-next]')?.addEventListener('click', () => step(1));
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });
    document.addEventListener('keydown', (e) => {
      if (box.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
  }
</script>
