---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import dezeWeek from '../data/deze-week.json';
import { aankomendeSpecials as specials, datumFormat, eventSchema as maakEventSchema, isExtern } from '../data/specials';
import sfeerVolleZaak from '../assets/sfeer/sfeer-volle-zaak.jpg';
import psvPoster from '../assets/psv-matchday.jpg';
import posterGameNights from '../assets/dagposters/game-nights.jpg';
import posterStelz from '../assets/dagposters/stelz-donderdag.webp';

// Grote versies voor de lightbox
const gameNightsGroot = await getImage({ src: posterGameNights, width: 1600, format: 'webp' });
const stelzGroot = await getImage({ src: posterStelz, width: 1080, format: 'webp' });

const dagNamen: Record<string, string> = {
  wo: 'Woensdag',
  do: 'Donderdag',
  vr: 'Vrijdag',
  za: 'Zaterdag',
  zo: 'Zondag',
};
const weekRegels = (['wo', 'do', 'vr', 'za', 'zo'] as const)
  .map((dag) => ({ dag: dagNamen[dag], tekst: (dezeWeek.dagen as Record<string, string>)[dag]?.trim() }))
  .filter((r) => r.tekst);

// Specials als schema.org/Event zodra ze bestaan (bouwprompt §6)
const eventSchema = maakEventSchema(specials);
---

<Base
  title="Agenda Café Costa | Uitgaan op het Stratumseind — elke week feest"
  description="Het weekprogramma van Café Costa Eindhoven: feest van woensdag t/m zaterdag, en elke PSV-wedstrijd live op zondag. Bekijk wat er deze week gebeurt."
  ogImage="/img/og-agenda.jpg"
>
  {eventSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}

  {/* PAGINAKOP */}
  <section class="bg-ink pt-16">
    <div class="wrap pb-6 pt-14 sm:pt-20">
      <p class="eyebrow text-paper/70"><span class="text-magenta-hot">Agenda</span> — Wo t/m za + PSV-zondag</p>
      <h1 class="display mt-2 text-[clamp(5rem,24vw,22rem)] leading-[0.82] text-paper">Agenda</h1>
    </div>
  </section>

  {/* SECTIE 1 — DEZE WEEK (het enige wekelijkse blok, bron: src/data/deze-week.json).
      Poster wekelijks vervangen: public/deze-week/programma.jpg (zelfde bestandsnaam). */}
  <section class="bg-ink">
    <div class="wrap border-t border-white/20 pb-20 pt-10 sm:pb-28">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="display display-lg">Deze week <span class="text-magenta-hot">bij Costa</span></h2>
        {dezeWeek.weekLabel && dezeWeek.weekLabel !== 'deze week' && (
          <p class="eyebrow text-paper/60">{dezeWeek.weekLabel}</p>
        )}
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-start">
        {dezeWeek.poster && (
          <button
            type="button"
            data-lightbox-src={dezeWeek.poster}
            data-lightbox-alt={dezeWeek.posterAlt}
            class="ruimte-foto group relative block cursor-zoom-in lg:col-span-5"
            aria-label="Vergroot de weekposter"
          >
            <img
              src={dezeWeek.poster}
              alt={dezeWeek.posterAlt}
              width="1080"
              height="1350"
              fetchpriority="high"
              class="w-full"
            />
            <span class="foto-badge !h-auto !w-auto gap-2 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.2em]" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg>
              Vergroot
            </span>
          </button>
        )}

        {weekRegels.length > 0 && (
          <ul class:list={['border-t border-white/20', dezeWeek.poster ? 'lg:col-span-6 lg:col-start-7' : 'lg:col-span-12']}>
            {weekRegels.map((r) => (
              <li class="grid gap-1 border-b border-white/20 py-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <span class="display text-3xl text-magenta-hot">{r.dag}</span>
                <span class="text-lg text-paper/90 sm:pt-1.5">{r.tekst}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  {/* Lightbox voor week- en dagposters — vergroot op de site, weg te klikken */}
  <div
    id="poster-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/95 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Poster van Café Costa, vergroot"
  >
    <button
      type="button"
      data-poster-close
      class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center bg-paper text-ink transition-colors hover:bg-magenta hover:text-white focus-visible:outline-3 focus-visible:outline-magenta-hot sm:right-6 sm:top-6"
      aria-label="Sluiten"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    <img id="poster-lightbox-image" src="" alt="" class="max-h-full w-auto max-w-full" />
  </div>

  {/* SECTIE 2 — HET VASTE WEEKPROGRAMMA */}
  <section class="bg-paper text-ink">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow"><span class="text-magenta">Vast programma</span></p>
          <h2 class="display display-xl mt-5">Elke week. <span class="text-magenta">Elke avond anders.</span></h2>
        </div>
        <p class="text-lg text-ink/75 lg:col-span-5 lg:self-end">
          Vier vaste avonden, één vast recept: elke week een andere line-up uit onze vaste poule van acht feest-DJ's,
          entertainment en een zaal die om 01:00 nog net zo vol staat als om 23:00. En op zondag? Dan kijken we PSV.
        </p>
      </div>

      {/* TODO: liggende (16:9) dagposters voor vrijdag/zaterdag zodra beschikbaar — wo en do hebben er al een. */}
      <div class="mt-14 border-t-2 border-ink">
        <article class="grid gap-6 border-b border-ink/20 py-10 lg:grid-cols-12">
          <p class="display text-6xl text-magenta lg:col-span-2">Wo</p>
          <div class="lg:col-span-6">
            <h3 class="display display-md">Costa's Game Nights</h3>
            <p class="mt-4 text-ink/75">
              Midden in de week, gratis meespelen: darts, beerpong, XXL Jenga, de borrelkrokodil en een stapel bord-
              en kaartspellen. Verlies je? Dan trakteer jij. Win je? Dan ook eigenlijk wel.
            </p>
            <p class="eyebrow mt-4 text-ink/55">Deuren open 19:00 · tot 02:00</p>
          </div>
          <button
            type="button"
            data-lightbox-src={gameNightsGroot.src}
            data-lightbox-alt="Poster: Cafe Costa's Game Nights, elke woensdagavond"
            class="ruimte-foto group relative block w-full max-w-72 cursor-zoom-in self-start overflow-hidden lg:col-span-4 lg:justify-self-end"
            aria-label="Vergroot de Game Nights-poster"
          >
            <Image
              src={posterGameNights}
              alt="Poster: Cafe Costa's Game Nights, elke woensdagavond"
              widths={[288, 576, 960]}
              sizes="288px"
              loading="lazy"
              class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="foto-badge" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
          </button>
        </article>

        <article class="grid gap-6 border-b border-ink/20 py-10 lg:grid-cols-12">
          <p class="display text-6xl text-magenta lg:col-span-2">Do</p>
          <div class="lg:col-span-6">
            <h3 class="display display-md">Studentendonderdag</h3>
            <p class="mt-4 text-ink/75">
              De kick-off van je weekend. Wisselende acties, wisselende DJ's, en één constante: donderdag bij Costa
              voelt nooit als een doordeweekse dag. Welke actie er deze week loopt? Die staat bovenaan deze pagina.
            </p>
            <p class="eyebrow mt-4 text-ink/55">Deuren open 19:00 · tot 02:00</p>
          </div>
          <button
            type="button"
            data-lightbox-src={stelzGroot.src}
            data-lightbox-alt="Poster: Costa op Stëlz'n — 3 Stëlz voor € 10 op donderdagavond"
            class="ruimte-foto group relative block w-full max-w-40 cursor-zoom-in self-start overflow-hidden lg:col-span-4 lg:justify-self-end"
            aria-label="Vergroot de donderdag-actieposter"
          >
            <Image
              src={posterStelz}
              alt="Poster: Costa op Stëlz'n — 3 Stëlz voor € 10 op donderdagavond"
              widths={[160, 320, 640]}
              sizes="160px"
              loading="lazy"
              class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="foto-badge" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
          </button>
        </article>

        <article class="grid gap-6 border-b border-ink/20 py-10 lg:grid-cols-12">
          <p class="display text-6xl text-magenta lg:col-span-2">Vr</p>
          <div class="lg:col-span-6">
            <h3 class="display display-md">De Ontlading</h3>
            <p class="mt-4 text-ink/75">
              De werkweek zit erop en dat gaat iemand merken. Feest-DJ's, entertainment aan de bar en een zaal die van
              borrel naar escalatie schuift zonder dat je doorhebt wanneer het gebeurde.
            </p>
            <p class="eyebrow mt-4 text-ink/55">Deuren open 19:00 · tot 04:00</p>
          </div>
        </article>

        <article class="grid gap-6 border-b border-ink/20 py-10 lg:grid-cols-12">
          <p class="display text-6xl text-magenta lg:col-span-2">Za</p>
          <div class="lg:col-span-6">
            <h3 class="display display-md">Het Hoofdpodium</h3>
            <p class="mt-4 text-ink/75">
              De grootste avond van de week. De bekendste feest-DJ's van het land, confettikanonnen en een vloer die
              tot sluit vol staat. Dit is de avond waarvoor mensen uit het hele land naar het Stratumseind komen.
            </p>
            <p class="eyebrow mt-4 text-ink/55">Deuren open 17:00 · tot 04:00</p>
          </div>
          <Image
            src={sfeerVolleZaak}
            alt="Stampvolle zaal bij Café Costa op zaterdagavond"
            widths={[480, 768, 1200]}
            sizes="(min-width: 1024px) 30vw, 100vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover lg:col-span-4"
          />
        </article>

        <article class="grid gap-6 py-10 lg:grid-cols-12">
          <p class="display text-6xl text-magenta lg:col-span-2">Zo</p>
          <div class="lg:col-span-6">
            <h3 class="display display-md">PSV-zondag</h3>
            <p class="mt-4 text-ink/75">
              Speelt PSV? Dan is Costa open. Elke wedstrijd op groot scherm, met de sfeer die je van ons gewend bent —
              en na het laatste fluitsignaal gaat het feest gewoon door. Binnen op groot scherm én buiten op ons
              terras. Kampioensduels, topper of uitwedstrijd: jij kijkt hier.
            </p>
          </div>
          {/* MATCHDAY-poster als staande kaart naast de tekst (ronde 3, §6) */}
          <Image
            src={psvPoster}
            alt="MATCHDAY-poster: kijk elke PSV-wedstrijd bij Café Costa, live op groot scherm, binnen en buiten op het terras"
            widths={[288, 576, 1080]}
            sizes="(min-width: 1024px) 288px, 100vw"
            loading="lazy"
            class="w-full max-w-72 lg:col-span-4 lg:justify-self-end"
          />
        </article>
      </div>
    </div>
  </section>

  {/* SECTIE 3 — SPECIALS & EVENTS: geen aankomende specials = sectie onzichtbaar (bron: src/data/specials.json) */}
  {
    specials.length > 0 && (
      <section class="bg-ink">
        <div class="wrap py-20 sm:py-28">
          <h2 class="display display-xl">Specials</h2>
          <div class="mt-10 border-t border-white/20">
            {specials.map((s) => (
              <article class="grid gap-6 border-b border-white/20 py-10 lg:grid-cols-12">
                {s.poster && (
                  <img src={s.poster} alt={s.posterAlt ?? `Poster: ${s.titel}`} loading="lazy" class="aspect-video w-full object-cover lg:col-span-5" />
                )}
                <div class:list={[s.poster ? 'lg:col-span-6 lg:col-start-7' : 'lg:col-span-12']}>
                  <p class="eyebrow text-magenta-hot">{datumFormat.format(new Date(s.datum))}</p>
                  <h3 class="display display-md mt-3">{s.titel}</h3>
                  <p class="mt-4 max-w-2xl text-paper/80">{s.tekst}</p>
                  {s.lineup?.length && (
                    <p class="eyebrow mt-4 text-paper/60">Line-up: {s.lineup.join(' · ')}</p>
                  )}
                  {s.ticketUrl && (
                    <a
                      href={s.ticketUrl}
                      class="btn-primary mt-6"
                      {...(isExtern(s.ticketUrl) ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      Tickets
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* SECTIE 4 — AFSLUITER */}
  <section class="bg-magenta text-white">
    <div class="wrap grid gap-8 py-20 sm:py-28 lg:grid-cols-12 lg:items-end">
      <h2 class="display display-xl lg:col-span-7">Zeker weten dat je erbij bent?</h2>
      <div class="lg:col-span-5">
        <p class="text-lg text-white/90">
          De leukste avonden zijn de drukste. Leg je plek vast met een VIP-tafel — dan hoef jij alleen nog te komen.
        </p>
        <a href="/groepen#vip-tafel" class="btn-primary mt-8 !bg-ink hover:!bg-ink-2">Boek een VIP-tafel</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Lightbox voor week- en dagposters: openen bij klik op elke knop met
  // data-lightbox-src; sluiten via kruisje, klik naast de poster, of Escape.
  const box = document.getElementById('poster-lightbox');
  const imgEl = document.getElementById('poster-lightbox-image') as HTMLImageElement | null;
  if (box && imgEl) {
    const openers = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]');
    const closeBtn = box.querySelector<HTMLButtonElement>('[data-poster-close]');
    let lastFocused: HTMLElement | null = null;

    const open = (src: string, alt: string) => {
      imgEl.src = src;
      imgEl.alt = alt;
      lastFocused = document.activeElement as HTMLElement;
      box.classList.remove('hidden');
      box.classList.add('flex');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    };
    const close = () => {
      box.classList.add('hidden');
      box.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    openers.forEach((btn) =>
      btn.addEventListener('click', () => open(btn.dataset.lightboxSrc ?? '', btn.dataset.lightboxAlt ?? ''))
    );
    closeBtn?.addEventListener('click', close);
    // Klik op de achtergrond (niet op de poster zelf) sluit
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !box.classList.contains('hidden')) close();
    });
  }
</script>
