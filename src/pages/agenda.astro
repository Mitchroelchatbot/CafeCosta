---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PalmFrond from '../components/PalmFrond.astro';
import dezeWeek from '../data/deze-week.json';
import specialsData from '../data/specials.json';
import { SITE } from '../data/site';
import sfeerVolleZaak from '../assets/sfeer/sfeer-volle-zaak.jpg';
import sfeerTerras from '../assets/sfeer/sfeer-terras.jpg';

const dagNamen: Record<string, string> = {
  wo: 'Woensdag',
  do: 'Donderdag',
  vr: 'Vrijdag',
  za: 'Zaterdag',
  zo: 'Zondag',
};
const weekRegels = (['wo', 'do', 'vr', 'za', 'zo'] as const)
  .map((dag) => ({ dag: dagNamen[dag], tekst: (dezeWeek.dagen as Record<string, string>)[dag]?.trim() }))
  .filter((r) => r.tekst);

type Special = { titel: string; datum: string; tekst: string; poster?: string | null; ticketUrl?: string | null };
const specials = (specialsData.specials as Special[]) ?? [];

// Specials als schema.org/Event zodra ze bestaan (bouwprompt §6)
const eventSchema =
  specials.length > 0
    ? {
        '@context': 'https://schema.org',
        '@graph': specials.map((s) => ({
          '@type': 'Event',
          name: s.titel,
          startDate: s.datum,
          description: s.tekst,
          ...(s.poster ? { image: new URL(s.poster, SITE.url).href } : {}),
          ...(s.ticketUrl ? { offers: { '@type': 'Offer', url: s.ticketUrl } } : {}),
          location: {
            '@type': 'BarOrPub',
            name: SITE.name,
            address: {
              '@type': 'PostalAddress',
              streetAddress: SITE.address.street,
              addressLocality: SITE.address.city,
              addressCountry: SITE.address.country,
            },
          },
        })),
      }
    : null;

const datumFormat = new Intl.DateTimeFormat('nl-NL', { weekday: 'long', day: 'numeric', month: 'long' });
---

<Base
  title="Agenda Café Costa | Uitgaan op het Stratumseind — elke week feest"
  description="Het weekprogramma van Café Costa Eindhoven: feest van woensdag t/m zaterdag, en elke PSV-wedstrijd live op zondag. Bekijk wat er deze week gebeurt."
  ogImage="/img/og-agenda.jpg"
>
  {eventSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}

  {/* SECTIE 1 — DEZE WEEK (het enige wekelijkse blok, bron: src/data/deze-week.json).
      Poster wekelijks vervangen: public/deze-week/programma.jpg (zelfde bestandsnaam). */}
  <section class="relative mx-auto max-w-6xl overflow-hidden px-4 pb-16 pt-32 sm:px-6 sm:pt-40">
    <PalmFrond flip class="absolute -right-14 top-20 h-40 w-52 text-teal/20 sm:h-52 sm:w-64" />
    <h1 class="display text-4xl text-white sm:text-6xl">
      Deze week <span class="text-sun">bij Costa</span>
    </h1>
    {dezeWeek.weekLabel && dezeWeek.weekLabel !== 'deze week' && (
      <p class="mt-3 text-lg font-bold uppercase tracking-wide text-cream/60">{dezeWeek.weekLabel}</p>
    )}

    <div class="mt-10 grid gap-8 lg:grid-cols-5 lg:items-start">
      {dezeWeek.poster && (
        <button
          type="button"
          data-poster-open
          class="group relative block cursor-zoom-in lg:col-span-2"
          aria-label="Vergroot de weekposter"
        >
          <img
            src={dezeWeek.poster}
            alt={dezeWeek.posterAlt}
            width="1080"
            height="1350"
            fetchpriority="high"
            class="w-full rounded-2xl border border-night-line shadow-xl transition-transform group-hover:scale-[1.01]"
          />
          <span
            class="pointer-events-none absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full bg-night/80 px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-cream backdrop-blur-sm transition-opacity group-hover:bg-magenta"
            aria-hidden="true"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path>
            </svg>
            Vergroot
          </span>
        </button>
      )}

      {weekRegels.length > 0 && (
        <ul
          class:list={[
            'divide-y divide-night-line overflow-hidden rounded-2xl border border-night-line bg-night-soft',
            dezeWeek.poster ? 'lg:col-span-3' : 'lg:col-span-5',
          ]}
        >
          {weekRegels.map((r) => (
            <li class="flex flex-col gap-1 px-6 py-5 sm:flex-row sm:items-baseline sm:gap-6">
              <span class="display w-28 shrink-0 text-sm text-magenta-hot">{r.dag}</span>
              <span class="text-lg text-cream/90">{r.tekst}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {/* Lightbox voor de weekposter — vergroot op de site, weg te klikken */}
  {dezeWeek.poster && (
    <div
      id="poster-lightbox"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-night/90 p-4 backdrop-blur-sm sm:p-8"
      role="dialog"
      aria-modal="true"
      aria-label="Weekprogramma van Café Costa, vergroot"
    >
      <button
        type="button"
        data-poster-close
        class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-night-soft text-cream transition-colors hover:bg-magenta focus-visible:outline-4 focus-visible:outline-sun sm:right-6 sm:top-6"
        aria-label="Sluiten"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
      <img
        src={dezeWeek.poster}
        alt={dezeWeek.posterAlt}
        class="max-h-full w-auto max-w-full rounded-xl shadow-2xl"
      />
    </div>
  )}

  {/* SECTIE 2 — HET VASTE WEEKPROGRAMMA */}
  <section class="border-y border-night-line bg-night-soft">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="display max-w-3xl text-3xl text-white sm:text-5xl">
        Elke week. <span class="text-teal">Elke avond anders.</span>
      </h2>
      <p class="mt-6 max-w-2xl text-lg text-cream/85">
        Vier vaste avonden, één vast recept: elke week een andere line-up uit onze vaste poule van acht feest-DJ's,
        entertainment en een zaal die om 01:00 nog net zo vol staat als om 23:00. En op zondag? Dan kijken we PSV.
      </p>

      {/*
        TODO: per dag een LIGGENDE (16:9) dagposter toevoegen zodra beschikbaar — nu tijdelijk zonder beeld.
        Alleen de Game Nights-poster bestaat al (liggende variant); voor do/vr/za moeten ze nog gemaakt worden.
        Staande posters zijn voor Instagram, niet voor de site.
      */}
      <div class="mt-12 space-y-6">
        <article class="rounded-2xl border border-night-line bg-night p-8">
          <h3 class="display text-xl text-sun">Woensdag — Costa's Game Nights</h3>
          <p class="mt-4 max-w-3xl text-cream/85">
            Midden in de week, gratis meespelen: darts, beerpong, XXL Jenga, de borrelkrokodil en een stapel bord- en
            kaartspellen. Verlies je? Dan trakteer jij. Win je? Dan ook eigenlijk wel.
          </p>
          <p class="mt-3 text-sm font-bold uppercase tracking-wide text-cream/60">Deuren open 19:00 · tot 02:00</p>
        </article>

        <article class="rounded-2xl border border-night-line bg-night p-8">
          <h3 class="display text-xl text-magenta-hot">Donderdag — Studentendonderdag</h3>
          <p class="mt-4 max-w-3xl text-cream/85">
            De kick-off van je weekend. Wisselende acties, wisselende DJ's, en één constante: donderdag bij Costa voelt
            nooit als een doordeweekse dag. Welke actie er deze week loopt? Die staat bovenaan deze pagina.
          </p>
          <p class="mt-3 text-sm font-bold uppercase tracking-wide text-cream/60">Deuren open 19:00 · tot 02:00</p>
        </article>

        <article class="rounded-2xl border border-night-line bg-night p-8">
          <h3 class="display text-xl text-teal">Vrijdag — De Ontlading</h3>
          <p class="mt-4 max-w-3xl text-cream/85">
            De werkweek zit erop en dat gaat iemand merken. Feest-DJ's, entertainment aan de bar en een zaal die van
            borrel naar escalatie schuift zonder dat je doorhebt wanneer het gebeurde.
          </p>
          <p class="mt-3 text-sm font-bold uppercase tracking-wide text-cream/60">Deuren open 19:00 · tot 04:00</p>
        </article>

        <article class="overflow-hidden rounded-2xl border border-night-line bg-night">
          <Image
            src={sfeerVolleZaak}
            alt="Stampvolle zaal bij Café Costa op zaterdagavond"
            widths={[480, 768, 1200]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            loading="lazy"
            class="aspect-[21/9] w-full object-cover"
          />
          <div class="p-8">
            <h3 class="display text-xl text-sun">Zaterdag — Het Hoofdpodium</h3>
            <p class="mt-4 max-w-3xl text-cream/85">
              De grootste avond van de week. De bekendste feest-DJ's van het land, confettikanonnen en een vloer die
              tot sluit vol staat. Dit is de avond waarvoor mensen uit het hele land naar het Stratumseind komen.
            </p>
            <p class="mt-3 text-sm font-bold uppercase tracking-wide text-cream/60">Deuren open 17:00 · tot 04:00</p>
          </div>
        </article>

        {/* TODO: MATCHDAY-poster (staand) als kaart naast deze tekst zodra het bestand geleverd is (ronde 3, §6) */}
        <article class="rounded-2xl border border-night-line bg-night p-8">
          <h3 class="display text-xl text-magenta-hot">Zondag — PSV-zondag</h3>
          <div class="mt-4 grid gap-6 lg:grid-cols-2 lg:items-center">
            <p class="max-w-3xl text-cream/85">
              Speelt PSV? Dan is Costa open. Elke wedstrijd op groot scherm, met de sfeer die je van ons gewend bent —
              en na het laatste fluitsignaal gaat het feest gewoon door. Binnen op groot scherm én buiten op ons
              terras. Kampioensduels, topper of uitwedstrijd: jij kijkt hier.
            </p>
            <Image
              src={sfeerTerras}
              alt="Het terras van Café Costa op het Stratumseind"
              widths={[480, 768, 1200]}
              sizes="(min-width: 1024px) 45vw, 100vw"
              loading="lazy"
              class="aspect-[16/9] w-full rounded-xl object-cover"
            />
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* SECTIE 3 — SPECIALS & EVENTS: geen aankomende specials = sectie onzichtbaar (bron: src/data/specials.json) */}
  {
    specials.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <h2 class="display text-3xl text-white sm:text-5xl">Specials</h2>
        <div class="mt-10 space-y-6">
          {specials.map((s) => (
            <article class="overflow-hidden rounded-2xl border border-night-line bg-night-soft">
              {s.poster && (
                <img src={s.poster} alt={`Poster: ${s.titel}`} loading="lazy" class="aspect-video w-full object-cover" />
              )}
              <div class="p-8">
                <p class="text-sm font-bold uppercase tracking-wide text-sun">{datumFormat.format(new Date(s.datum))}</p>
                <h3 class="display mt-2 text-xl text-white">{s.titel}</h3>
                <p class="mt-4 max-w-3xl text-cream/85">{s.tekst}</p>
                {s.ticketUrl && (
                  <a href={s.ticketUrl} class="btn-primary mt-6" target="_blank" rel="noopener">
                    Tickets
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {/* SECTIE 4 — AFSLUITER */}
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <h2 class="display max-w-3xl text-3xl text-white sm:text-5xl">
      Zeker weten dat je erbij bent<span class="text-magenta-hot">?</span>
    </h2>
    <p class="mt-6 max-w-2xl text-lg text-cream/85">
      De leukste avonden zijn de drukste. Leg je plek vast met een VIP-tafel — dan hoef jij alleen nog te komen.
    </p>
    <a href="/groepen#vip-tafel" class="btn-primary mt-8">Boek een VIP-tafel</a>
  </section>
</Base>

<script>
  // Lightbox voor de weekposter: openen bij klik, sluiten via kruisje,
  // klik naast de poster, of Escape.
  const box = document.getElementById('poster-lightbox');
  if (box) {
    const openers = document.querySelectorAll<HTMLButtonElement>('[data-poster-open]');
    const closeBtn = box.querySelector<HTMLButtonElement>('[data-poster-close]');
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      box.classList.remove('hidden');
      box.classList.add('flex');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    };
    const close = () => {
      box.classList.add('hidden');
      box.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    openers.forEach((btn) => btn.addEventListener('click', open));
    closeBtn?.addEventListener('click', close);
    // Klik op de achtergrond (niet op de poster zelf) sluit
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !box.classList.contains('hidden')) close();
    });
  }
</script>
