---
import Base from '../layouts/Base.astro';
---

<Base
  title="Aanvraag ontvangen | Café Costa Eindhoven"
  description="Je aanvraag is binnen! Je hoort binnen 24 uur van ons."
>
  <section class="mx-auto flex min-h-svh max-w-3xl flex-col justify-center px-4 py-32 sm:px-6">
    <h1 class="display text-4xl text-white sm:text-6xl">Je aanvraag is <span class="text-sun">binnen!</span></h1>
    <p class="mt-6 max-w-xl text-lg text-cream/85">
      Je hoort binnen 24 uur van ons — meestal veel sneller. Houd je mail (en spamfolder) in de gaten.
    </p>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <a href="/agenda" class="btn-secondary">Bekijk de agenda</a>
      <a href="/" class="btn-primary">Terug naar home</a>
    </div>
  </section>
</Base>
