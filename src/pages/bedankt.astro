---
import Base from '../layouts/Base.astro';
---

<Base
  title="Aanvraag ontvangen | Café Costa Eindhoven"
  description="Je aanvraag is binnen! Je hoort binnen 24 uur van ons."
>
  <section class="flex min-h-svh flex-col justify-center bg-magenta pt-16 text-white">
    <div class="wrap py-20">
      <p class="eyebrow">Boekingsaanvraag</p>
      <h1 class="display display-hero mt-4">Je aanvraag is binnen!</h1>
      <p class="mt-8 max-w-xl text-lg text-white/90">
        Je hoort binnen 24 uur van ons — meestal veel sneller. Houd je mail (en spamfolder) in de gaten.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-primary !bg-ink hover:!bg-ink-2">Terug naar home</a>
        <a href="/agenda" class="btn-secondary text-white hover:!border-ink hover:!bg-ink">Bekijk de agenda</a>
      </div>
    </div>
  </section>
</Base>
