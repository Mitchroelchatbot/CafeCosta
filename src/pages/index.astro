---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import { JAREN_COSTA } from '../data/site';
import ruimteLichtshow from '../assets/ruimte/ruimte-overzicht-lichtshow.jpg';
import sfeerHanden from '../assets/sfeer/sfeer-handen-omhoog.jpg';

// Het vaste weekritme (bron: costa-agenda.md) — verandert vrijwel nooit
const weekritme = [
  { dag: 'Wo', naam: "Costa's Game Nights" },
  { dag: 'Do', naam: 'Studentendonderdag' },
  { dag: 'Vr', naam: 'De Ontlading' },
  { dag: 'Za', naam: 'Het Hoofdpodium' },
  { dag: 'Zo', naam: 'PSV-zondag' },
];
---

<Base
  title="Café Costa Eindhoven | Feestcafé op het Stratumseind — VIP-tafels & besloten feesten"
  description={`Al ${JAREN_COSTA} jaar hét feestcafé van het Stratumseind. Boek een VIP-tafel of huur onze besloten ruimte voor 20–60 personen — zonder zaalhuur.`}
>
  {/* HERO — fullscreen videoloop, gedempt, autoplay, met posterframe als fallback */}
  <section class="relative flex min-h-svh flex-col justify-end overflow-hidden">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/img/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/video/costa-hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-ink/55" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink via-ink/60 to-transparent" aria-hidden="true"></div>

    <div class="wrap relative pb-8 pt-28 sm:pb-12">
      <p class="eyebrow text-paper/80"><span class="text-magenta-hot">Sinds 2002</span> — Stratumseind 31, Eindhoven</p>
      <h1 class="display display-hero mt-4 max-w-[14ch] text-paper">
        Het feestcafé in <span class="text-magenta-hot">zomerse sferen</span>
      </h1>

      <div class="mt-8 grid gap-8 border-t border-white/20 pt-6 lg:grid-cols-12 lg:items-end">
        <p class="max-w-xl text-lg text-paper/85 lg:col-span-6">
          Sinds 2002 de zomerse hotspot van het Stratumseind, het gehele jaar door. Confettikanonnen, de beste
          feest-DJ's en een groot team met één opdracht: jouw beste avond, het hele jaar door.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-6 lg:justify-end">
          <a href="/groepen" class="btn-primary">Zet je avond vast</a>
          <a href="/agenda" class="btn-secondary text-paper">Dit weekend bij Costa</a>
        </div>
      </div>
    </div>
  </section>

  <Marquee items={['Zet je avond vast', 'De verborgen parel', 'VIP-tafels', 'Wo t/m za', 'PSV-zondag', '3× beste feestcafé van NL']} />

  {/* TEASER GROEPEN & VERHUUR — de belangrijkste sectie; besloten ruimte is het hoofdproduct */}
  <section class="bg-paper text-ink">
    <div class="wrap py-20 sm:py-28">
      <p class="eyebrow"><span class="text-magenta">01</span> — Groepen &amp; verhuur</p>
      <h2 class="display display-xl mt-5 max-w-[18ch]">
        Het best bewaarde geheim <span class="text-magenta">van de langste stapstraat van de Benelux</span>
      </h2>
      <p class="mt-8 max-w-2xl text-lg text-ink/75">
        Vijftig kroegen telt het Stratumseind, en al sinds 2002 feest Costa er middenin. Maar wat de meeste stappers
        nooit te zien krijgen: verscholen in ons café ligt een verborgen parel. Een complete besloten ruimte met eigen
        bar, eigen DJ-booth en eigen lichtshow — en voor één avond is hij helemaal van jou.
      </p>

      <div class="mt-14 grid border-t border-ink lg:grid-cols-12">
        <a href="/groepen#besloten-ruimte" class="group relative block overflow-hidden lg:col-span-7">
          <Image
            src={ruimteLichtshow}
            alt="De besloten ruimte van Café Costa met sfeerverlichting en lichtshow"
            widths={[480, 768, 1200]}
            sizes="(min-width: 1024px) 58vw, 100vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] lg:aspect-auto lg:h-full"
          />
        </a>
        <div class="flex flex-col py-8 lg:col-span-5 lg:py-10 lg:pl-10">
          <p class="eyebrow text-ink/60">Het hoofdproduct</p>
          <h3 class="display display-lg mt-3">De verborgen parel</h3>
          <p class="mt-5 text-ink/75">
            Je eigen feest, één trap boven het Stratumseind. Voor 20 tot 60 personen, met eigen bar, DJ-booth en
            lichtshow. Geen zaalhuur — alleen een minimale barbesteding van € 600.
          </p>
          <a href="/groepen#besloten-ruimte" class="btn-primary mt-8 self-start">Huur de verborgen parel</a>
        </div>
      </div>

      <div class="grid gap-6 border-y border-ink py-8 lg:grid-cols-12 lg:items-center">
        <h3 class="display display-md lg:col-span-3">VIP-tafel</h3>
        <p class="text-ink/75 lg:col-span-6">
          Jullie eigen tafel, midden in het feest. Voor 6 tot 12 personen, inclusief € 150 drankentegoed en
          welkomstshotjes. Maximaal 3 per avond.
        </p>
        <a href="/groepen#vip-tafel" class="btn-secondary self-start lg:col-span-3 lg:justify-self-end">Boek een VIP-tafel</a>
      </div>
    </div>
  </section>

  {/* TEASER AGENDA — het vaste weekritme als typografische lijst */}
  <section class="bg-ink">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow"><span class="text-magenta-hot">02</span> — Agenda</p>
          <h2 class="display display-xl mt-5">
            Elke week feest. <span class="text-magenta-hot">Elke avond anders.</span>
          </h2>
          <p class="mt-8 max-w-md text-lg text-paper/75">
            Van de bekendste feest-DJ's tot themafeesten en artiesten op de bar: bij Costa is het programma nooit
            hetzelfde, maar de afloop wel — confetti in je haar en een verhaal voor maandag.
          </p>
          <a href="/agenda" class="btn-secondary mt-8 text-paper">Bekijk de agenda</a>
        </div>

        <ol class="border-t border-white/20 lg:col-span-6 lg:col-start-7">
          {
            weekritme.map((d) => (
              <li>
                <a href="/agenda" class="group flex items-baseline gap-5 border-b border-white/20 py-4 sm:gap-8 sm:py-5">
                  <span class="display w-14 shrink-0 text-3xl text-paper/40 transition-colors group-hover:text-magenta-hot sm:w-20 sm:text-5xl">
                    {d.dag}
                  </span>
                  <span class="display text-2xl sm:text-4xl">{d.naam}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* WAAROM COSTA — full-bleed foto met de claim erover */}
  <section class="relative overflow-hidden">
    <Image
      src={sfeerHanden}
      alt="Volle zaal bij Café Costa met handen in de lucht tijdens een DJ-set"
      widths={[768, 1200, 1920]}
      sizes="100vw"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-ink/70" aria-hidden="true"></div>
    <div class="wrap relative grid gap-10 py-24 sm:py-36 lg:grid-cols-12 lg:items-end">
      <h2 class="display display-xl lg:col-span-8">
        Drie keer beste feestcafé van Nederland. <span class="text-magenta-hot">En elke avond opnieuw bewijzen.</span>
      </h2>
      <p class="max-w-md text-lg text-paper/85 lg:col-span-4">
        Sinds 2002 op Stratumseind 31. Drie landelijke awards, publiek uit het hele land, en een simpele filosofie:
        Champions League spelen op horecagebied. Maar awards hangen aan de muur — het feest staat op de vloer. Kom het
        zelf meemaken.
      </p>
      {/* TODO (optioneel, zie contentdoc): drie korte Google-reviewquotes van één zin — geen sterren-widgets of embeds */}
    </div>
  </section>
</Base>
