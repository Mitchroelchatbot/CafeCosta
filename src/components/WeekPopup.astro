---
/**
 * Weekprogramma-popup: verschijnt eenmalig bij het openen van de site en
 * onthoudt de sluiting per weekeditie (localStorage, gekeyd op weekLabel) —
 * een nieuwe weekposter mag dus opnieuw één keer oppoppen.
 * Makkelijk afsluitbaar: kruisje, klik naast de poster, of Escape.
 * Wordt niet getoond op /agenda (daar staat het programma al) en op de
 * bevestigingspagina's — zie Base.astro.
 */
import dezeWeek from '../data/deze-week.json';

const tonen = Boolean(dezeWeek.poster);
const popupKey = `costa-weekpopup:${dezeWeek.weekLabel || 'onbekend'}`;
---

{
  tonen && (
    <div
      id="week-popup"
      data-popup-key={popupKey}
      class="fixed inset-0 z-50 hidden items-center justify-center bg-night/85 p-4 backdrop-blur-sm sm:p-8"
      role="dialog"
      aria-modal="true"
      aria-label="Het weekprogramma van Café Costa"
    >
      <div class="relative flex max-h-full w-full max-w-sm flex-col">
        <button
          type="button"
          data-week-popup-close
          class="absolute -right-2 -top-2 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-magenta text-white shadow-lg transition-colors hover:bg-magenta-hot focus-visible:outline-4 focus-visible:outline-sun"
          aria-label="Sluiten"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>

        <p class="display rounded-t-2xl bg-night-soft px-5 py-3 text-sm text-sun">
          Deze week bij Costa{dezeWeek.weekLabel && dezeWeek.weekLabel !== 'deze week' ? ` · ${dezeWeek.weekLabel}` : ''}
        </p>
        <img
          src={dezeWeek.poster}
          alt={dezeWeek.posterAlt}
          width="1080"
          height="1350"
          loading="lazy"
          class="min-h-0 w-full flex-1 bg-night-soft object-contain"
        />
        <div class="rounded-b-2xl bg-night-soft p-4">
          <a href="/agenda" class="btn-primary w-full !py-3">Bekijk de agenda</a>
        </div>
      </div>
    </div>
  )
}

<script>
  const popup = document.getElementById('week-popup');
  if (popup) {
    const key = popup.dataset.popupKey ?? 'costa-weekpopup';
    let alGezien = false;
    try {
      alGezien = localStorage.getItem(key) !== null;
    } catch {
      alGezien = true; // geen storage (privémodus met blokkade) → liever niet elke keer poppen
    }

    if (!alGezien) {
      const close = () => {
        popup.classList.add('hidden');
        popup.classList.remove('flex');
        document.body.style.overflow = '';
        try {
          localStorage.setItem(key, String(Date.now()));
        } catch {
          /* geen storage — dan poppen we een volgende keer gewoon nog eens */
        }
      };

      // Even wachten zodat de pagina eerst rustig kan laden
      setTimeout(() => {
        popup.classList.remove('hidden');
        popup.classList.add('flex');
        document.body.style.overflow = 'hidden';
        popup.querySelector<HTMLButtonElement>('[data-week-popup-close]')?.focus();
      }, 900);

      popup.querySelector('[data-week-popup-close]')?.addEventListener('click', close);
      popup.querySelector('a[href="/agenda"]')?.addEventListener('click', close);
      popup.addEventListener('click', (e) => {
        if (e.target === popup) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !popup.classList.contains('hidden')) close();
      });
    }
  }
</script>
