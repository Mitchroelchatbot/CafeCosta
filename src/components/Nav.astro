---
import Logo from './Logo.astro';

const links = [
  { href: '/agenda', label: 'Agenda' },
  { href: '/groepen', label: 'Groepen & Verhuur' },
  { href: '/over', label: 'Over Costa' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-night/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6" aria-label="Hoofdmenu">
    {/* Kaal woordmerk (zonder EINDHOVEN) in de header, conform ronde 3 §3; max ±56px hoog op mobiel */}
    <a href="/" class="text-white transition-colors hover:text-magenta-hot" aria-label="Café Costa — home">
      <Logo variant="kaal" class="h-11" />
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={current === l.href ? 'page' : undefined}
            class:list={[
              'text-sm font-bold uppercase tracking-wide transition-colors hover:text-sun',
              current === l.href ? 'text-sun' : 'text-cream/90',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a href="/groepen#aanvragen" class="btn-primary !px-6 !py-2.5 !text-sm">Zet je avond vast</a>
    </div>

    <button
      id="menu-toggle"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-cream md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menu openen"
    >
      <svg id="icon-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg id="icon-close" class="hidden" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-night px-4 pb-6 pt-2 md:hidden">
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={current === l.href ? 'page' : undefined}
          class:list={[
            'block border-b border-white/5 py-4 text-lg font-bold uppercase tracking-wide',
            current === l.href ? 'text-sun' : 'text-cream',
          ]}
        >
          {l.label}
        </a>
      ))
    }
    <a href="/groepen#aanvragen" class="btn-primary mt-5 w-full">Zet je avond vast</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
