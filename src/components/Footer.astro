---
import { SITE } from '../data/site';
import Logo from './Logo.astro';
import Toucan from './Toucan.astro';
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/10 bg-night-soft">
  {/* Toekan — klein huisstijldetail van de oude site, puur decoratief */}
  <Toucan class="absolute right-6 -top-9 h-16 sm:right-10 sm:-top-10 sm:h-[4.5rem]" />

  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
    <a href="/" class="inline-block text-cream/90 transition-colors hover:text-white" aria-label="Café Costa — home">
      <Logo class="h-12" />
    </a>
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
    <div>
      <h2 class="display mb-3 text-sm text-sun">Bezoek ons</h2>
      <p class="text-cream/85">
        Café Costa<br />
        Stratumseind 31, Eindhoven
      </p>
    </div>

    <div>
      <h2 class="display mb-3 text-sm text-sun">Open</h2>
      <p class="text-cream/85">
        Woensdag t/m zaterdag — en op zondag bij elke wedstrijd van PSV<br />
        Deuren open om 19:00, zaterdag al om 17:00<br />
        Vrijdag &amp; zaterdag tot 04:00, overige dagen tot 02:00
      </p>
    </div>

    <div>
      <h2 class="display mb-3 text-sm text-sun">Boeken</h2>
      <p class="text-cream/85">
        VIP-tafel of besloten feest? →
        <a href="/groepen#aanvragen" class="font-bold text-magenta-hot underline-offset-4 hover:underline">Zet je avond vast</a>
      </p>
    </div>

    <div>
      <h2 class="display mb-3 text-sm text-sun">Volg het feest</h2>
      {/* De enige plek op de site met social-verwijzingen — alleen iconen (bouwprompt §8) */}
      <div class="flex gap-4">
        <a href={SITE.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram van Café Costa" class="text-cream/80 transition-colors hover:text-magenta-hot">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a href={SITE.socials.facebook} target="_blank" rel="noopener" aria-label="Facebook van Café Costa" class="text-cream/80 transition-colors hover:text-magenta-hot">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-7h2.6l.4-3h-3V9.1c0-.9.3-1.5 1.6-1.5H16.6V4.9c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9V11H8v3h2.5v7h3z"></path>
          </svg>
        </a>
        {
          SITE.socials.tiktok && (
            <a href={SITE.socials.tiktok} target="_blank" rel="noopener" aria-label="TikTok van Café Costa" class="text-cream/80 transition-colors hover:text-magenta-hot">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16.6 3c.3 1.7 1.4 3.1 3.4 3.4v3c-1.4 0-2.5-.4-3.4-1v6.2c0 3.5-2.4 5.9-5.6 5.9A5.4 5.4 0 0 1 5.5 15c0-3.2 2.5-5.6 5.9-5.4v3.1c-1.7-.3-2.9.7-2.9 2.2 0 1.4 1 2.4 2.4 2.4 1.5 0 2.6-1.1 2.6-2.9V3h3.1z"></path>
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-4 py-5 text-sm text-cream/60 sm:px-6">
      © {year} Café Costa · <a href="/privacy" class="underline-offset-4 hover:text-cream hover:underline">Privacyverklaring</a> · Vanaf 18 jaar
    </p>
  </div>
</footer>
