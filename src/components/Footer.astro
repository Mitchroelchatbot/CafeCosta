---
import { SITE } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:py-20">
    <div>
      <h2 class="eyebrow text-paper/50">Bezoek ons</h2>
      <p class="mt-3 text-paper">
        Café Costa<br />
        Stratumseind 31, Eindhoven
      </p>
    </div>

    <div>
      <h2 class="eyebrow text-paper/50">Open</h2>
      <p class="mt-3 text-paper">
        Woensdag t/m zaterdag — en op zondag bij elke wedstrijd van PSV<br />
        Deuren open om 19:00, zaterdag al om 17:00<br />
        Vrijdag &amp; zaterdag tot 04:00, overige dagen tot 02:00
      </p>
    </div>

    <div>
      <h2 class="eyebrow text-paper/50">Boeken</h2>
      <p class="mt-3 text-paper">
        VIP-tafel of besloten feest?<br />
        <a href="/groepen#aanvragen" class="font-semibold text-magenta-hot underline-offset-4 hover:underline">Zet je avond vast →</a>
      </p>
    </div>

    <div>
      <h2 class="eyebrow text-paper/50">Volg het feest</h2>
      {/* De enige plek op de site met social-verwijzingen — alleen iconen (bouwprompt §8) */}
      <div class="mt-3 flex gap-5">
        <a href={SITE.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram van Café Costa" class="text-paper transition-colors hover:text-magenta-hot">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a href={SITE.socials.facebook} target="_blank" rel="noopener" aria-label="Facebook van Café Costa" class="text-paper transition-colors hover:text-magenta-hot">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-7h2.6l.4-3h-3V9.1c0-.9.3-1.5 1.6-1.5H16.6V4.9c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9V11H8v3h2.5v7h3z"></path>
          </svg>
        </a>
        {
          SITE.socials.tiktok && (
            <a href={SITE.socials.tiktok} target="_blank" rel="noopener" aria-label="TikTok van Café Costa" class="text-paper transition-colors hover:text-magenta-hot">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16.6 3c.3 1.7 1.4 3.1 3.4 3.4v3c-1.4 0-2.5-.4-3.4-1v6.2c0 3.5-2.4 5.9-5.6 5.9A5.4 5.4 0 0 1 5.5 15c0-3.2 2.5-5.6 5.9-5.4v3.1c-1.7-.3-2.9.7-2.9 2.2 0 1.4 1 2.4 2.4 2.4 1.5 0 2.6-1.1 2.6-2.9V3h3.1z"></path>
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>

  {/* Het woordmerk over de volle breedte als afsluiter */}
  <div class="wrap pb-6">
    <a href="/" class="block text-paper transition-colors hover:text-magenta-hot" aria-label="Café Costa — home">
      <Logo variant="kaal" class="block h-auto w-full [&_svg]:!h-auto [&_svg]:!w-full" />
    </a>
  </div>

  <div class="border-t border-white/10">
    <p class="wrap eyebrow flex flex-wrap gap-x-4 gap-y-1 py-5 text-paper/50">
      <span>© {year} Café Costa</span>
      <a href="/privacy" class="hover:text-paper">Privacyverklaring</a>
      <span>Vanaf 18 jaar</span>
    </p>
  </div>
</footer>
